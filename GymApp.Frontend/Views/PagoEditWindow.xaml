<Window x:Class="GymApp.Frontend.Views.PagoEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registrar Pago"
        Height="520" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F5F5"
        ShowInTaskbar="False">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="💰 Registrar Pago" 
                   FontSize="22" 
                   FontWeight="Bold"
                   Foreground="#2C3E50"
                   Margin="0,0,0,20"/>

        <Border Grid.Row="1" 
                Background="White" 
                CornerRadius="6" 
                Padding="20"
                BorderBrush="#E0E0E0"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Socio -->
                <TextBlock Grid.Row="0" Grid.Column="0" 
                           Text="Socio *" 
                           VerticalAlignment="Center"
                           Margin="0,0,10,12"
                           FontWeight="SemiBold"/>
                <ComboBox Grid.Row="0" Grid.Column="1" 
                          x:Name="CmbSocio"
                          DisplayMemberPath="NombreCompleto"
                          Margin="0,0,0,12"
                          Padding="8,6"
                          FontSize="13"/>

                <!-- Monto -->
                <TextBlock Grid.Row="1" Grid.Column="0" 
                           Text="Monto *" 
                           VerticalAlignment="Center"
                           Margin="0,0,10,12"
                           FontWeight="SemiBold"/>
                <TextBox Grid.Row="1" Grid.Column="1" 
                         x:Name="TxtMonto"
                         Margin="0,0,0,12"
                         FontSize="13"/>

                <!-- Método de pago -->
                <TextBlock Grid.Row="2" Grid.Column="0" 
                           Text="Método de Pago *" 
                           VerticalAlignment="Center"
                           Margin="0,0,10,12"
                           FontWeight="SemiBold"/>
                <ComboBox Grid.Row="2" Grid.Column="1" 
                          x:Name="CmbMetodo"
                          Margin="0,0,0,12"
                          Padding="8,6"
                          FontSize="13"
                          SelectedIndex="0">
                    <ComboBoxItem Content="Efectivo"/>
                    <ComboBoxItem Content="Tarjeta"/>
                    <ComboBoxItem Content="Transferencia"/>
                </ComboBox>

                <!-- Observaciones -->
                <TextBlock Grid.Row="3" Grid.Column="0" 
                           Text="Observaciones" 
                           VerticalAlignment="Top"
                           Margin="0,8,10,0"
                           FontWeight="SemiBold"/>
                <TextBox Grid.Row="3" Grid.Column="1" 
                         x:Name="TxtObservaciones"
                         Margin="0,0,0,0"
                         FontSize="13"
                         Height="80"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         MaxLength="500"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button Content="💾 Guardar" 
                    Click="BtnGuardar_Click"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Width="120" Height="36"/>
            <Button Content="❌ Cancelar" 
                    Click="BtnCancelar_Click"
                    Background="#95A5A6"
                    Foreground="White"
                    BorderThickness="0"
                    Padding="15,8"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                    Width="120" Height="36"
                    Margin="10,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>