<UserControl x:Class="GymApp.Frontend.Views.MembresiasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:GymApp.Frontend.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MembresiasViewModel}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ENCABEZADO -->
        <TextBlock Grid.Row="0" 
                   Text="🎫 Gestión de Membresías" 
                   FontSize="26" 
                   FontWeight="Bold"
                   Foreground="#2C3E50"
                   Margin="0,0,0,15"/>

        <!-- BOTONES -->
        <StackPanel Grid.Row="1" 
                    Orientation="Horizontal" 
                    Margin="0,0,0,15">
            <Button Content="➕ Nueva Membresía" 
                    Command="{Binding NuevaCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"/>
            <Button Content="✏️ Editar" 
                    Command="{Binding EditarCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"/>
            <Button Content="🗑️ Eliminar" 
                    Command="{Binding EliminarCommand}"
                    Style="{StaticResource DangerButtonStyle}"/>
            <Button Content="🔄 Refrescar" 
                    Command="{Binding CargarCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"/>
        </StackPanel>

        <!-- TABLA -->
        <Border Grid.Row="2" 
                Background="White" 
                CornerRadius="6"
                BorderBrush="#E0E0E0"
                BorderThickness="1">
            <DataGrid ItemsSource="{Binding Membresias}"
                      SelectedItem="{Binding MembresiaSeleccionada}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#EEEEEE"
                      RowHeight="38"
                      FontSize="13"
                      BorderThickness="0"
                      RowBackground="White"
                      AlternatingRowBackground="#F9F9F9">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                    <DataGridTextColumn Header="Socio" Width="*">
                        <DataGridTextColumn.Binding>
                            <MultiBinding StringFormat="{}{0} {1}">
                                <Binding Path="Socio.Nombre"/>
                                <Binding Path="Socio.Apellido"/>
                            </MultiBinding>
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="120"/>
                    <DataGridTextColumn Header="Inicio" 
                                        Binding="{Binding FechaInicio, StringFormat=dd/MM/yyyy}" 
                                        Width="110"/>
                    <DataGridTextColumn Header="Fin" 
                                        Binding="{Binding FechaFin, StringFormat=dd/MM/yyyy}" 
                                        Width="110"/>
                    <DataGridTextColumn Header="Precio" 
                                        Binding="{Binding Precio, StringFormat=C}" 
                                        Width="100"/>
                    <DataGridCheckBoxColumn Header="Activa" Binding="{Binding Activa}" Width="70"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>