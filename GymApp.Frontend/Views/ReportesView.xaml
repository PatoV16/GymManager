<UserControl x:Class="GymApp.Frontend.Views.ReportesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:GymApp.Frontend.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ReportesViewModel}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ENCABEZADO -->
            <Grid Grid.Row="0" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="📊 Reportes" 
                           FontSize="26" 
                           FontWeight="Bold"
                           Foreground="#2C3E50"/>
                <Button Grid.Column="1"
                        Content="🔄 Refrescar" 
                        Command="{Binding CargarCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"/>
            </Grid>

            <!-- TARJETAS DE MÉTRICAS -->
            <Grid Grid.Row="1" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Socios activos -->
                <Border Grid.Column="0" Background="#27AE60" CornerRadius="6" Padding="15" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="👥 Socios Activos" Foreground="White" FontSize="12" Opacity="0.9"/>
                        <TextBlock Text="{Binding SociosActivos}" Foreground="White" FontSize="28" FontWeight="Bold" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Socios totales -->
                <Border Grid.Column="1" Background="#3498DB" CornerRadius="6" Padding="15" Margin="6,0,6,0">
                    <StackPanel>
                        <TextBlock Text="👤 Socios Totales" Foreground="White" FontSize="12" Opacity="0.9"/>
                        <TextBlock Text="{Binding SociosTotales}" Foreground="White" FontSize="28" FontWeight="Bold" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Membresías activas -->
                <Border Grid.Column="2" Background="#9B59B6" CornerRadius="6" Padding="15" Margin="6,0,6,0">
                    <StackPanel>
                        <TextBlock Text="🎫 Membresías Activas" Foreground="White" FontSize="12" Opacity="0.9"/>
                        <TextBlock Text="{Binding MembresiasActivas}" Foreground="White" FontSize="28" FontWeight="Bold" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Ingresos del mes -->
                <Border Grid.Column="3" Background="#E67E22" CornerRadius="6" Padding="15" Margin="6,0,0,0">
                    <StackPanel>
                        <TextBlock Text="💰 Ingresos del Mes" Foreground="White" FontSize="12" Opacity="0.9"/>
                        <TextBlock Text="{Binding IngresosMes, StringFormat=C}" Foreground="White" FontSize="22" FontWeight="Bold" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- MEMBRESÍAS POR VENCER -->
            <Border Grid.Row="2" 
                    Background="White" 
                    CornerRadius="6" 
                    Padding="15"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="⚠️ Membresías por Vencer (próximos 7 días)" 
                               FontSize="16" 
                               FontWeight="Bold"
                               Foreground="#E67E22"
                               Margin="0,0,0,10"/>
                    <DataGrid ItemsSource="{Binding MembresiasPorVencer}"
                              AutoGenerateColumns="True"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              RowHeight="32"
                              FontSize="13"
                              BorderThickness="0"
                              Background="Transparent"
                              MaxHeight="200">
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- INGRESOS POR MES -->
            <Border Grid.Row="3" 
                    Background="White" 
                    CornerRadius="6" 
                    Padding="15"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="📈 Ingresos por Mes (últimos 6 meses)" 
                               FontSize="16" 
                               FontWeight="Bold"
                               Foreground="#27AE60"
                               Margin="0,0,0,10"/>
                    <DataGrid ItemsSource="{Binding IngresosMensuales}"
                              AutoGenerateColumns="True"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              RowHeight="32"
                              FontSize="13"
                              BorderThickness="0"
                              Background="Transparent"
                              MaxHeight="250">
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- TOP SOCIOS -->
            <Border Grid.Row="4" 
                    Background="White" 
                    CornerRadius="6" 
                    Padding="15"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="🏆 Top 5 Socios con Más Pagos" 
                               FontSize="16" 
                               FontWeight="Bold"
                               Foreground="#9B59B6"
                               Margin="0,0,0,10"/>
                    <DataGrid ItemsSource="{Binding TopSocios}"
                              AutoGenerateColumns="True"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              RowHeight="32"
                              FontSize="13"
                              BorderThickness="0"
                              Background="Transparent"
                              MaxHeight="250">
                    </DataGrid>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>