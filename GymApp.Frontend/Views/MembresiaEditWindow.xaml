<Window x:Class="GymApp.Frontend.Views.MembresiaEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nueva Membresía"
        Height="560" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F5F5"
        ShowInTaskbar="False">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   x:Name="TituloVentana"
                   Text="➕ Nueva Membresía" 
                   FontSize="22" 
                   FontWeight="Bold"
                   Foreground="#2C3E50"
                   Margin="0,0,0,20"/>

        <Border Grid.Row="1" 
                Background="White" 
                CornerRadius="6" 
                Padding="20"
                BorderBrush="#E0E0E0"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Socio -->
                <TextBlock Grid.Row="0" Grid.Column="0" 
                           Text="Socio *" 
                           VerticalAlignment="Center"
                           Margin="0,0,10,12"
                           FontWeight="SemiBold"/>
                <ComboBox Grid.Row="0" Grid.Column="1" 
                          x:Name="CmbSocio"
                          DisplayMemberPath="NombreCompleto"
                          Margin="0,0,0,12"
                          Padding="8,6"
                          FontSize="13"/>

                <!-- Tipo -->
                <TextBlock Grid.Row="1" Grid.Column="0" 
                           Text="Tipo *" 
                           VerticalAlignment="Center"
                           Margin="0,0,10,12"
                           FontWeight="SemiBold"/>
                <ComboBox Grid.Row="1" Grid.Column="1" 
                          x:Name="CmbTipo"
                          Margin="0,0,0,12"
                          Padding="8,6"
                          FontSize="13"
                          SelectionChanged="CmbTipo_SelectionChanged">
                    <ComboBoxItem Content="Mensual"/>
                    <ComboBoxItem Content="Trimestral"/>
                    <ComboBoxItem Content="Semestral"/>
                    <ComboBoxItem Content="Anual"/>
                </ComboBox>

                <!-- Fecha inicio -->
                <TextBlock Grid.Row="2" Grid.Column="0" 
                           Text="Fecha Inicio *" 
                           VerticalAlignment="Center"
                           Margin="0,0,10,12"
                           FontWeight="SemiBold"/>
                <DatePicker Grid.Row="2" Grid.Column="1" 
                            x:Name="DpFechaInicio"
                            Margin="0,0,0,12"
                            FontSize="13"/>

                <!-- Fecha fin -->
                <TextBlock Grid.Row="3" Grid.Column="0" 
                           Text="Fecha Fin *" 
                           VerticalAlignment="Center"
                           Margin="0,0,10,12"
                           FontWeight="SemiBold"/>
                <DatePicker Grid.Row="3" Grid.Column="1" 
                            x:Name="DpFechaFin"
                            Margin="0,0,0,12"
                            FontSize="13"/>

                <!-- Precio -->
                <TextBlock Grid.Row="4" Grid.Column="0" 
                           Text="Precio *" 
                           VerticalAlignment="Center"
                           Margin="0,0,10,12"
                           FontWeight="SemiBold"/>
                <TextBox Grid.Row="4" Grid.Column="1" 
                         x:Name="TxtPrecio"
                         Margin="0,0,0,12"
                         FontSize="13"/>

                <!-- Activa -->
                <TextBlock Grid.Row="5" Grid.Column="0" 
                           Text="Activa" 
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"
                           FontWeight="SemiBold"/>
                <CheckBox Grid.Row="5" Grid.Column="1" 
                          x:Name="ChkActiva"
                          IsChecked="True"
                          VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button Content="💾 Guardar" 
                    Click="BtnGuardar_Click"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Width="120" Height="36"/>
            <Button Content="❌ Cancelar" 
                    Click="BtnCancelar_Click"
                    Background="#95A5A6"
                    Foreground="White"
                    BorderThickness="0"
                    Padding="15,8"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                    Width="120" Height="36"
                    Margin="10,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>