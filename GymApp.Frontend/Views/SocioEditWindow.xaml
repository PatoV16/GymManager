<Window x:Class="GymApp.Frontend.Views.SocioEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nuevo Socio"
        Height="560" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F5F5"
        ShowInTaskbar="False">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== ENCABEZADO ===== -->
        <TextBlock Grid.Row="0" 
                   x:Name="TituloVentana"
                   Text="➕ Nuevo Socio" 
                   FontSize="22" 
                   FontWeight="Bold"
                   Foreground="#2C3E50"
                   Margin="0,0,0,20"/>

        <!-- ===== FORMULARIO ===== -->
        <Border Grid.Row="1" 
                Background="White" 
                CornerRadius="6" 
                Padding="20"
                BorderBrush="#E0E0E0"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Nombre -->
                <TextBlock Grid.Row="0" Grid.Column="0" 
                           Text="Nombre *" 
                           VerticalAlignment="Center"
                           Margin="0,0,10,12"
                           FontWeight="SemiBold"/>
                <TextBox Grid.Row="0" Grid.Column="1" 
                         x:Name="TxtNombre"
                         Margin="0,0,0,12"
                         MaxLength="100"/>

                <!-- Apellido -->
                <TextBlock Grid.Row="1" Grid.Column="0" 
                           Text="Apellido *" 
                           VerticalAlignment="Center"
                           Margin="0,0,10,12"
                           FontWeight="SemiBold"/>
                <TextBox Grid.Row="1" Grid.Column="1" 
                         x:Name="TxtApellido"
                         Margin="0,0,0,12"
                         MaxLength="100"/>

                <!-- Cédula -->
                <TextBlock Grid.Row="2" Grid.Column="0" 
                           Text="Cédula *" 
                           VerticalAlignment="Center"
                           Margin="0,0,10,12"
                           FontWeight="SemiBold"/>
                <TextBox Grid.Row="2" Grid.Column="1" 
                         x:Name="TxtCedula"
                         Margin="0,0,0,12"
                         MaxLength="20"/>

                <!-- Teléfono -->
                <TextBlock Grid.Row="3" Grid.Column="0" 
                           Text="Teléfono" 
                           VerticalAlignment="Center"
                           Margin="0,0,10,12"
                           FontWeight="SemiBold"/>
                <TextBox Grid.Row="3" Grid.Column="1" 
                         x:Name="TxtTelefono"
                         Margin="0,0,0,12"
                         MaxLength="20"/>

                <!-- Email -->
                <TextBlock Grid.Row="4" Grid.Column="0" 
                           Text="Email" 
                           VerticalAlignment="Center"
                           Margin="0,0,10,12"
                           FontWeight="SemiBold"/>
                <TextBox Grid.Row="4" Grid.Column="1" 
                         x:Name="TxtEmail"
                         Margin="0,0,0,12"
                         MaxLength="150"/>

                <!-- Fecha de nacimiento -->
                <TextBlock Grid.Row="5" Grid.Column="0" 
                           Text="Fecha Nacimiento *" 
                           VerticalAlignment="Center"
                           Margin="0,0,10,12"
                           FontWeight="SemiBold"/>
                <DatePicker Grid.Row="5" Grid.Column="1" 
                            x:Name="DpFechaNacimiento"
                            Margin="0,0,0,12"
                            FontSize="13"/>

                <!-- Activo -->
                <TextBlock Grid.Row="6" Grid.Column="0" 
                           Text="Activo" 
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"
                           FontWeight="SemiBold"/>
                <CheckBox Grid.Row="6" Grid.Column="1" 
                          x:Name="ChkActivo"
                          IsChecked="True"
                          VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ===== BOTONES ===== -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button Content="💾 Guardar" 
                    Click="BtnGuardar_Click"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Width="120" Height="36"/>
            <Button Content="❌ Cancelar" 
                    Click="BtnCancelar_Click"
                    Background="#95A5A6"
                    Foreground="White"
                    BorderThickness="0"
                    Padding="15,8"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                    Width="120" Height="36"
                    Margin="10,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>